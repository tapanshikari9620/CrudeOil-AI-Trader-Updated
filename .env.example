APP_NAME=CrudeOil-AI-Trader
APP_ENV=development
TRADING_MODE=PAPER
DATABASE_URL=sqlite:///./data/example.db
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
MARKET_TIMEZONE=Asia/Kolkata

MAX_TRADES_PER_DAY=5
MAX_PAPER_LOTS_PER_TRADE=1

# Adaptive ATR-based stop and risk-multiple target (no fixed INR loss/target gates)
ATR_STOP_MULTIPLIER=25.0
MIN_STOP_RISK_FRACTION=0.08
MAX_STOP_RISK_FRACTION=0.35
BASE_REWARD_MULTIPLE=2.0

# Add Upstox credentials only in your local .env during a later phase.
# UPSTOX_CLIENT_ID=
# UPSTOX_CLIENT_SECRET=
# UPSTOX_REDIRECT_URI=
# UPSTOX_ACCESS_TOKEN=

# Continuous read-only MCX crude futures and CE/PE collection
LIVE_FUTURES_POLL_SECONDS=5
LIVE_OPTIONS_POLL_SECONDS=15
LIVE_MAX_CONTRACTS_PER_CYCLE=200
LIVE_API_TIMEOUT_SECONDS=15
LIVE_RETRY_COUNT=2
LIVE_RETRY_BACKOFF_SECONDS=1
LIVE_QUOTE_FRESHNESS_SECONDS=120
MCX_MARKET_OPEN_TIME=09:00
MCX_MARKET_CLOSE_TIME=23:30
LIVE_CONTRACT_REFRESH_SECONDS=900
